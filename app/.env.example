# Dev only. Leave unset to use http://localhost:8000 (iOS simulator) or http://10.0.2.2:8000 (Android emulator).
# Physical device: http://<your-computer-LAN-IP>:8000
# Release builds REQUIRE this to be set, and to an https:// URL.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to use the canned response (no backend needed)
EXPO_PUBLIC_USE_MOCK=0
